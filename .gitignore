!output/chess_lo_1.txt
!output/chess_lo_100.txt
!output/chess_lo_1000.txt
!output/docExample_PHMN.txt
!output/e8_a_mushroom_100000_ma100_r1.txt
!output/e8_a_mushroom_100000_ma10_r1.txt
!output/e8_a_mushroom_100000_ma5_r1.txt
!output/e8_a_pumsb_5800000_ma2000_r1.txt
!output/pumsb_f_5400000.txt
!output/pumsb_f_5600000.txt
